package com.hex.ecomcs.controller;

import java.util.List;

import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.hex.ecomcs.dto.CustomerInfoDto;
import com.hex.ecomcs.service.CustomerService;

import lombok.AllArgsConstructor;

@RestController
@RequestMapping("/api/customer")
@AllArgsConstructor
public class CustomerController {
	
	private final CustomerService customerService;

	@GetMapping("/info")
	public List<CustomerInfoDto> getCustomerWithProductBoughtCount() {
		return customerService.getCustomerWithProductBoughtCount();
	}
}
